DATABASE_URL=sqlite+aiosqlite:///./phuket_invest.db
# Replace the values below with real credentials — never commit actual keys
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN

# Scraper settings
SCRAPER_DELAY_MIN=2.0
SCRAPER_DELAY_MAX=5.0
SCRAPER_MAX_PAGES=20
SCRAPER_HEADLESS=true
LOG_LEVEL=INFO
